    { "text": "Pendant que le loup n'y est pas.", "notes": "C4:0.5 C4:0.5 C4:0.5 C4:0.5 D4:0.5 D4:0.5 G3:1" },
    { "text": "Si le loup y était,", "notes": "C4:0.5 C4:0.5 C4:1 D4:1 E4:1" },
