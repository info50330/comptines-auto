  "lines": [
    { "text": "Il pleut, il pleut, bergère,", "notes": "R:2.5 E4:0.5 G4:1 E4:0.5 G4:1 E4:0.5 C4:1.5 G3:1.5" },
    { "text": "Rentre tes blancs moutons.", "notes": "C4:0.5 B3:0.5 C4:0.5 D4:1 D4:0.5 E4:3" },
    { "text": "Allons sous ma chaumière,", "notes": "E4:0.5 D4:0.5 E4:0.5 F4:1 F4:0.5 G4:1.5 E4:1.5" },
    { "text": "Bergère, vite allons.", "notes": "G4:0.5 A4:0.5 G4:0.5 F4:1 E4:0.5 E4:1.5 D4:1 R:0.5" },
    { "text": "J'entends sous le feuillage", "notes": "D4:0.5 D4:0.5 D4:0.5 F4:1 F4:0.5 E4:1.5 G4:1.5" },
    { "text": "L'eau qui tombe à grand bruit.", "notes": "F4:0.5 E4:0.5 D4:0.5 E4:1 C4:0.5 E4:1.5 D4:1 E4:0.5" },
    { "text": "Voici venir l'orage,", "notes": "G4:1 E4:0.5 G4:1 E4:0.5 F4:1.5 A4:1.5" },
